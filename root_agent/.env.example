GOOGLE_GENAI_USE_VERTEXAI=TRUE
GCP_PROJECT_ID=[your_project_id]
GCP_LOCATION=us-central1
GOOGLE_CLOUD_LOCATION=global

BQ_PROJECT_ID=[your_bigquery_project_id]
BQ_DATASET_ID=[your_bigquery_dataset]
BQ_LOCATION=US
BQ_MAX_RESULT_ROWS=200
BQ_MAX_BYTES_BILLED=10737418240

# The AUTH_ID you set when registering the agent in Gemini Enterprise.
# Gemini Enterprise injects the user's forwarded OAuth token into session state
# under this exact key — it must match the Authorization Name in GE exactly.
# Agent Engine : uncomment and set GE_AUTH_ID
# Local        : leave commented out (uses Application Default Credentials)
# GE_AUTH_ID=[your_gemini_enterprise_auth_id]

# Agent Engine resource ID — populated after first deploy, used for updates.
# Uncomment after first deployment and set the ID.
# AGENT_ENGINE_ID=[your_agent_engine_id]

ORCHESTRATOR_MODEL=gemini-3.1-flash-lite-preview
CHART_AGENT_MODEL=gemini-3.1-flash-lite-preview

# Artifact bucket — bare name, no gs:// prefix.
# ARTIFACT_SERVICE_URI is read by Agent Engine natively to persist artifacts.
# The bucket name is derived from it automatically in agent.py.
# Example: ARTIFACT_SERVICE_URI=gs://my-artifact-bucket
ARTIFACT_SERVICE_URI=gs://[your_artifact_bucket_name]

# Create once before first deployment using: python3 create_code_interpreter.py
# Example: CODE_INTERPRETER_EXTENSION_NAME=projects/123456789/locations/global/extensions/123456789
CODE_INTERPRETER_EXTENSION_NAME=[your_code_interpreter_extension_name]

GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=TRUE
