# Copy to .env and fill in your values. Never commit .env to source control.

# ── Google Cloud ───────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# ── BigQuery ───────────────────────────────────────────────────────────────────
BQ_PROJECT_ID=your-bq-project-id        # can be same as GCP_PROJECT_ID
BQ_DATASET_ID=your_dataset_id
BQ_LOCATION=US                           # dataset location: US, EU, etc.
BQ_MAX_RESULT_ROWS=200
BQ_MAX_BYTES_BILLED=10737418240          # 10 GB

# ── Models ────────────────────────────────────────────────────────────────────
ORCHESTRATOR_MODEL=gemini-3.1-flash-lite-preview
CHART_AGENT_MODEL=gemini-3.1-flash-lite-preview

# ── Gemini Enterprise OAuth ───────────────────────────────────────────────────
# Must exactly match the Authorization Name set when registering the agent
# in Gemini Enterprise. GE injects the user's access token into session state
# under this key after OAuth consent.
GE_AUTH_ID=your-ge-authorization-name

# ── Artifact Service ───────────────────────────────────────────────────────────
# URI used to persist chart artifacts to GCS
ARTIFACT_SERVICE_URI=gs://your-artifact-bucket-name/artifacts

# ── Code Interpreter ───────────────────────────────────────────────────────────
# Create once using the command in chart_agent.py prerequisites.
# Format: projects/PROJECT_NUMBER/locations/global/extensions/EXTENSION_ID
CODE_INTERPRETER_EXTENSION_NAME=projects/123456789/locations/global/extensions/123456789
